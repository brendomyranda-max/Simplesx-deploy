{
  "name": "servidor-doixp",
  "version": "1.5.20",
  "private": true,
  "description": "Servidor DoixP para impressoras e cartões NFC",
  "homepage": "https://doixp.com",
  "author": {
    "name": "DoixP"
  },
  "main": "src/main.cjs",
  "desktopName": "servidor-doixp.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:windows": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "build": {
    "appId": "com.simplesx.gestorimpressora",
    "productName": "Servidor DoixP",
    "artifactName": "servidor-doixp-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://doixp.com/atualizacoes/"
    },
    "linux": {
      "icon": "src/doixp-logo.png",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "DoixP",
      "synopsis": "Servidor DoixP para impressoras e cartões NFC"
    },
    "win": {
      "icon": "src/doixp-logo.png",
      "artifactName": "servidor-doixp-windows-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
