{
  "name": "simplexsa-gestor-impressora",
  "version": "1.5.13",
  "private": true,
  "description": "Agente local de impressao do SimplexS.A",
  "homepage": "https://simplesx-projeto-beta.pages.dev",
  "author": {
    "name": "SimplexS.A"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:windows": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "build": {
    "appId": "com.simplesx.gestorimpressora",
    "productName": "SimplexS.A Gestor",
    "artifactName": "simplexsa-gestor-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "SimplexS.A",
      "synopsis": "Agente local de impressao do SimplexS.A"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
