{
  "name": "servidor-doixp",
  "version": "1.5.14",
  "private": true,
  "description": "Servidor local de impressão da DoixP",
  "homepage": "https://doixp.com",
  "author": {
    "name": "DoixP"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:windows": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "build": {
    "appId": "com.simplesx.gestorimpressora",
    "productName": "Servidor DoixP",
    "artifactName": "servidor-doixp-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/*.ps1"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "DoixP",
      "synopsis": "Servidor local de impressão da DoixP"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
