# Copie para .env. O servidor e os scripts Node carregam esse arquivo.
# Variáveis exportadas no ambiente têm prioridade. Nunca versionar .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SIMPLESX_DB=./data/simplesx.db

# Chaves PÚBLICAS DE TESTE do Cloudflare. Nunca usar em produção.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Opcional: sem os três valores, a contribuição Pix fica indisponível.
# Prefira uma chave aleatória para evitar divulgar CPF/telefone no QR Code.
COLABORACAO_PIX_CHAVE=
COLABORACAO_PIX_NOME=
COLABORACAO_PIX_CIDADE=

# Apenas para npm run criar-token. Apague a senha após criar o usuário.
SIMPLESX_SENHA_DONO=

# Apenas para server/importar-cardapio-italiano.js.
SIMPLESX_URL=http://127.0.0.1:3001/api
SIMPLESX_TOKEN=
SIMPLESX_USUARIO=
SIMPLESX_SENHA=
