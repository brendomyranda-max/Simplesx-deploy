# Copie para wrangler.toml e informe os recursos da sua conta.
# Credenciais pertencem aos Secrets do Cloudflare, nunca a este arquivo.
name = "simplesx-projeto-beta"
compatibility_date = "2025-01-01"
pages_build_output_dir = "dist"

# Checkout Efí começa em homologação. Só altere para `production` após validar
# credenciais, split, notificações e a aprovação comercial da taxa.
[vars]
EFI_ENVIRONMENT = "sandbox"
EFI_PLATFORM_FEE_BPS = "2"
EFI_NOTIFICATION_URL = "https://doixp.com/api/public/efipay/checkout/notificacao"

# Recursos Cloudflare criados no deploy
[[d1_databases]]
binding = "DB"
database_name = "simplesx-db"
database_id = "SUBSTITUA_PELO_ID_DO_SEU_D1"

[[kv_namespaces]]
binding = "AUTH_KV"
id = "SUBSTITUA_PELO_ID_DO_SEU_KV"
