# Copie para .dev.vars somente no seu computador. Nunca envie .dev.vars ao Git.
# Opcional: somente para conciliar cobranças antigas da integração desativada.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_ENVIRONMENT=sandbox

# Chaves PÚBLICAS DE TESTE, somente para desenvolvimento com Wrangler.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Opcional: URL da instância Photon para endereços (sem chave no navegador).
PHOTON_URL=
